{
  "name": "terminal-sidebar",
  "displayName": "Terminal Sidebar",
  "description": "Sidebar terminals with Markdown, PDF, LaTeX, HTML, and formatted-source previews.",
  "version": "0.11.0",
  "publisher": "ConAntares",
  "author": "Lu Niu (Photonico)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Photonico/terminal_sidebar.git"
  },
  "bugs": {
    "url": "https://github.com/Photonico/terminal_sidebar/issues"
  },
  "homepage": "https://github.com/Photonico/terminal_sidebar#readme",
  "icon": "assets/logo.png",
  "categories": [
    "Other"
  ],
  "keywords": [
    "terminal",
    "sidebar",
    "shell",
    "cli",
    "pty",
    "pdf",
    "markdown",
    "preview"
  ],
  "engines": {
    "vscode": "^1.106.0",
    "node": ">=22"
  },
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Profiles can be configured, but terminals only run in trusted workspaces."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "A local or remote Node.js extension host is required to run shell processes."
    }
  },
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "terminalSidebar",
          "title": "Side Terminals",
          "icon": "assets/activity.svg"
        }
      ],
      "activitybar": [
        {
          "id": "terminalSidebarLeft",
          "title": "Side Terminals",
          "icon": "assets/activity.svg"
        }
      ]
    },
    "views": {
      "terminalSidebar": [
        {
          "id": "terminalSidebar.terminals",
          "name": "Side Terminals",
          "type": "webview"
        }
      ],
      "terminalSidebarLeft": [
        {
          "id": "terminalSidebar.left",
          "name": "Side Terminals",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "terminalSidebar.open",
        "title": "Open Secondary Terminal",
        "category": "Terminal Sidebar",
        "icon": "$(arrow-circle-right)"
      },
      {
        "command": "terminalSidebar.openLeft",
        "title": "Open Primary Terminal",
        "category": "Terminal Sidebar",
        "icon": "$(arrow-circle-left)"
      },
      {
        "command": "terminalSidebar.openProfile",
        "title": "Open Profile…",
        "category": "Terminal Sidebar",
        "icon": "$(list-selection)"
      },
      {
        "command": "terminalSidebar.configure",
        "title": "Configure Side Bars",
        "category": "Terminal Sidebar",
        "icon": "$(settings-gear)"
      },
      {
        "command": "terminalSidebar.restart",
        "title": "Restart Active Terminal",
        "category": "Terminal Sidebar",
        "icon": "$(refresh)"
      },
      {
        "command": "terminalSidebar.left.selectProfile",
        "title": "Open Profile…",
        "category": "Terminal Sidebar",
        "icon": "$(list-selection)"
      },
      {
        "command": "terminalSidebar.left.save",
        "title": "Save",
        "category": "Terminal Sidebar",
        "icon": "$(save)"
      },
      {
        "command": "terminalSidebar.left.undo",
        "title": "Undo Configuration Edit",
        "category": "Terminal Sidebar",
        "icon": "$(discard)",
        "enablement": "terminalSidebar.left.canUndo"
      },
      {
        "command": "terminalSidebar.left.redo",
        "title": "Redo Configuration Edit",
        "category": "Terminal Sidebar",
        "icon": "$(redo)",
        "enablement": "terminalSidebar.left.canRedo"
      },
      {
        "command": "terminalSidebar.left.close",
        "title": "Close",
        "category": "Terminal Sidebar",
        "icon": "$(close)"
      },
      {
        "command": "terminalSidebar.left.configure",
        "title": "Configure Side Bars",
        "category": "Terminal Sidebar",
        "icon": "$(settings-gear)"
      },
      {
        "command": "terminalSidebar.left.restart",
        "title": "Restart Terminal",
        "category": "Terminal Sidebar",
        "icon": "$(refresh)"
      },
      {
        "command": "terminalSidebar.right.selectProfile",
        "title": "Open Profile…",
        "category": "Terminal Sidebar",
        "icon": "$(list-selection)"
      },
      {
        "command": "terminalSidebar.right.save",
        "title": "Save",
        "category": "Terminal Sidebar",
        "icon": "$(save)"
      },
      {
        "command": "terminalSidebar.right.undo",
        "title": "Undo Configuration Edit",
        "category": "Terminal Sidebar",
        "icon": "$(discard)",
        "enablement": "terminalSidebar.right.canUndo"
      },
      {
        "command": "terminalSidebar.right.redo",
        "title": "Redo Configuration Edit",
        "category": "Terminal Sidebar",
        "icon": "$(redo)",
        "enablement": "terminalSidebar.right.canRedo"
      },
      {
        "command": "terminalSidebar.right.close",
        "title": "Close",
        "category": "Terminal Sidebar",
        "icon": "$(close)"
      },
      {
        "command": "terminalSidebar.right.configure",
        "title": "Configure Side Bars",
        "category": "Terminal Sidebar",
        "icon": "$(settings-gear)"
      },
      {
        "command": "terminalSidebar.right.restart",
        "title": "Restart Terminal",
        "category": "Terminal Sidebar",
        "icon": "$(refresh)"
      },
      {
        "command": "terminalSidebar.left.add",
        "title": "New Terminal",
        "category": "Terminal Sidebar",
        "icon": "$(add)"
      },
      {
        "command": "terminalSidebar.right.add",
        "title": "New Terminal",
        "category": "Terminal Sidebar",
        "icon": "$(add)"
      },
      {
        "command": "terminalSidebar.left.find",
        "title": "Find in Primary Terminal",
        "category": "Terminal Sidebar",
        "icon": "$(search)"
      },
      {
        "command": "terminalSidebar.right.find",
        "title": "Find in Secondary Terminal",
        "category": "Terminal Sidebar",
        "icon": "$(search)"
      },
      {
        "command": "terminalSidebar.openPreview",
        "title": "Preview in Sidebar Terminal",
        "category": "Terminal Sidebar",
        "icon": "$(open-preview)"
      },
      {
        "command": "terminalSidebar.openPdf",
        "title": "Open PDF Preview…",
        "category": "Terminal Sidebar",
        "icon": "$(file-pdf)"
      },
      {
        "command": "terminalSidebar.openMarkdown",
        "title": "Preview Markdown…",
        "category": "Terminal Sidebar",
        "icon": "$(markdown)"
      },
      {
        "command": "terminalSidebar.openLatex",
        "title": "Preview LaTeX PDF…",
        "category": "Terminal Sidebar",
        "icon": "$(file-pdf)"
      },
      {
        "command": "terminalSidebar.left.openPreview",
        "title": "Open Preview…",
        "category": "Terminal Sidebar",
        "icon": "$(open-preview)"
      },
      {
        "command": "terminalSidebar.left.openPdf",
        "title": "Open PDF Preview…",
        "category": "Terminal Sidebar",
        "icon": "$(open-preview)"
      },
      {
        "command": "terminalSidebar.right.openPreview",
        "title": "Open Preview…",
        "category": "Terminal Sidebar",
        "icon": "$(open-preview)"
      },
      {
        "command": "terminalSidebar.right.openPdf",
        "title": "Open PDF Preview…",
        "category": "Terminal Sidebar",
        "icon": "$(open-preview)"
      },
      {
        "command": "terminalSidebar.usage",
        "title": "Usage",
        "category": "Terminal Sidebar",
        "icon": "$(question)"
      },
      {
        "command": "terminalSidebar.about",
        "title": "About",
        "category": "Terminal Sidebar",
        "icon": "$(info)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "terminalSidebar.left.selectProfile",
          "when": "view == terminalSidebar.left",
          "group": "terminal@0"
        },
        {
          "command": "terminalSidebar.open",
          "when": "view == terminalSidebar.left",
          "group": "navigation@1"
        },
        {
          "command": "terminalSidebar.left.undo",
          "when": "view == terminalSidebar.left && terminalSidebar.left.configuring",
          "group": "navigation@3"
        },
        {
          "command": "terminalSidebar.left.redo",
          "when": "view == terminalSidebar.left && terminalSidebar.left.configuring",
          "group": "navigation@4"
        },
        {
          "command": "terminalSidebar.left.configure",
          "when": "view == terminalSidebar.left",
          "group": "navigation@6"
        },
        {
          "command": "terminalSidebar.left.restart",
          "when": "view == terminalSidebar.left",
          "group": "terminal@1"
        },
        {
          "command": "terminalSidebar.right.selectProfile",
          "when": "view == terminalSidebar.terminals",
          "group": "terminal@0"
        },
        {
          "command": "terminalSidebar.openLeft",
          "when": "view == terminalSidebar.terminals",
          "group": "navigation@1"
        },
        {
          "command": "terminalSidebar.right.undo",
          "when": "view == terminalSidebar.terminals && terminalSidebar.right.configuring",
          "group": "navigation@3"
        },
        {
          "command": "terminalSidebar.right.redo",
          "when": "view == terminalSidebar.terminals && terminalSidebar.right.configuring",
          "group": "navigation@4"
        },
        {
          "command": "terminalSidebar.right.configure",
          "when": "view == terminalSidebar.terminals",
          "group": "navigation@6"
        },
        {
          "command": "terminalSidebar.right.restart",
          "when": "view == terminalSidebar.terminals",
          "group": "terminal@1"
        },
        {
          "command": "terminalSidebar.usage",
          "when": "view == terminalSidebar.left || view == terminalSidebar.terminals",
          "group": "z_help@0"
        },
        {
          "command": "terminalSidebar.about",
          "when": "view == terminalSidebar.left || view == terminalSidebar.terminals",
          "group": "z_help@1"
        }
      ],
      "commandPalette": [
        {
          "command": "terminalSidebar.left.selectProfile",
          "when": "false"
        },
        {
          "command": "terminalSidebar.left.save",
          "when": "false"
        },
        {
          "command": "terminalSidebar.left.undo",
          "when": "false"
        },
        {
          "command": "terminalSidebar.left.redo",
          "when": "false"
        },
        {
          "command": "terminalSidebar.left.close",
          "when": "false"
        },
        {
          "command": "terminalSidebar.left.configure",
          "when": "false"
        },
        {
          "command": "terminalSidebar.left.restart",
          "when": "false"
        },
        {
          "command": "terminalSidebar.right.selectProfile",
          "when": "false"
        },
        {
          "command": "terminalSidebar.right.save",
          "when": "false"
        },
        {
          "command": "terminalSidebar.right.undo",
          "when": "false"
        },
        {
          "command": "terminalSidebar.right.redo",
          "when": "false"
        },
        {
          "command": "terminalSidebar.right.close",
          "when": "false"
        },
        {
          "command": "terminalSidebar.right.configure",
          "when": "false"
        },
        {
          "command": "terminalSidebar.right.restart",
          "when": "false"
        },
        {
          "command": "terminalSidebar.left.add",
          "when": "false"
        },
        {
          "command": "terminalSidebar.right.add",
          "when": "false"
        },
        {
          "command": "terminalSidebar.left.openPreview",
          "when": "false"
        },
        {
          "command": "terminalSidebar.left.openPdf",
          "when": "false"
        },
        {
          "command": "terminalSidebar.right.openPreview",
          "when": "false"
        },
        {
          "command": "terminalSidebar.right.openPdf",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "terminalSidebar.openPreview",
          "when": "resourceScheme =~ /^(file|vscode-remote)$/ && resourceExtname =~ /\\.(pdf|md|markdown|mdown|mkd|mkdn|mdwn|tex|html|htm|css|json|jsonc)$/i",
          "group": "navigation@8"
        }
      ],
      "editor/title/context": [
        {
          "command": "terminalSidebar.openPreview",
          "when": "resourceScheme =~ /^(file|vscode-remote)$/ && resourceExtname =~ /\\.(pdf|md|markdown|mdown|mkd|mkdn|mdwn|tex|html|htm|css|json|jsonc)$/i",
          "group": "navigation@8"
        }
      ],
      "editor/title": [
        {
          "command": "terminalSidebar.openPreview",
          "when": "resourceScheme =~ /^(file|vscode-remote)$/ && resourceExtname =~ /\\.(pdf|md|markdown|mdown|mkd|mkdn|mdwn|tex|html|htm|css|json|jsonc)$/i",
          "group": "navigation@9"
        }
      ]
    },
    "configuration": {
      "title": "Terminal Sidebar",
      "properties": {
        "terminalSidebar.profiles": {
          "type": "array",
          "scope": "application",
          "markdownDescription": "Legacy startup profiles from 0.1 and 0.2. Used in the Secondary Side Bar only when terminalSidebar.sidebars has no explicit User value.",
          "default": [
            {
              "id": "default",
              "name": "Terminal",
              "command": "",
              "shell": ""
            }
          ],
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$",
                "description": "Stable unique ID. The visual editor creates this automatically."
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "description": "Displayed terminal tab name."
              },
              "command": {
                "type": "string",
                "default": "",
                "maxLength": 8192,
                "description": "Command to run once when this terminal starts. Blank opens an interactive shell."
              },
              "shell": {
                "type": "string",
                "default": "",
                "maxLength": 1024,
                "description": "Optional shell executable: powershell, cmd, bash, zsh, fish, or an executable path. Blank uses the VS Code default shell, then the system default. Do not include arguments."
              },
              "args": {
                "type": "array",
                "maxItems": 128,
                "items": {
                  "type": "string",
                  "maxLength": 8192,
                  "pattern": "^[^\u0000]*$"
                },
                "description": "Optional literal shell arguments. Replaces VS Code default-profile or login arguments; [] supplies none. At most 128 arguments, 8192 UTF-8 bytes each and 32768 bytes total including separators. Quotes and spaces are preserved."
              },
              "env": {
                "type": "object",
                "maxProperties": 128,
                "propertyNames": {
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[^=\u0000-\u001f]+$",
                  "not": {
                    "enum": [
                      "__proto__",
                      "constructor",
                      "prototype"
                    ]
                  }
                },
                "additionalProperties": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 8192,
                  "pattern": "^[^\u0000]*$"
                },
                "description": "Optional environment overrides applied after inherited and VS Code default-profile values, before shell lookup. Null removes a variable. Names are case-insensitive on Windows; reserved prototype names are rejected. At most 128 variables, 256 UTF-8 bytes per name, 8192 per value and 32768 in total including separators. Keep secrets out of synced settings."
              }
            }
          },
          "deprecationMessage": "Legacy startup profiles. Use Terminal Sidebar: Configure Side Bars to save independent Primary and Secondary Side Bar startup lists."
        },
        "terminalSidebar.sidebars": {
          "type": "object",
          "scope": "application",
          "additionalProperties": false,
          "required": [
            "left",
            "right"
          ],
          "markdownDescription": "Startup tabs for the Primary and Secondary Side Bars. Configure them with **Terminal Sidebar: Configure Side Bars**. Closing a live tab leaves these lists unchanged. Commands run once at sidebar startup; keep secrets out of synced settings.",
          "default": {
            "left": [],
            "right": [
              {
                "id": "default",
                "name": "Terminal",
                "command": "",
                "shell": ""
              }
            ]
          },
          "properties": {
            "left": {
              "type": "array",
              "default": [],
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "name"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,64}$",
                    "description": "Stable unique ID. The visual editor creates this automatically."
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80,
                    "description": "Name of the tab opened at sidebar startup."
                  },
                  "command": {
                    "type": "string",
                    "default": "",
                    "maxLength": 8192,
                    "description": "Command to run once when this terminal starts. Blank opens an interactive shell."
                  },
                  "shell": {
                    "type": "string",
                    "default": "",
                    "maxLength": 1024,
                    "description": "Optional shell executable: powershell, cmd, bash, zsh, fish, or an executable path. Blank uses the VS Code default shell, then the system default. Do not include arguments."
                  },
                  "args": {
                    "type": "array",
                    "maxItems": 128,
                    "items": {
                      "type": "string",
                      "maxLength": 8192,
                      "pattern": "^[^\u0000]*$"
                    },
                    "description": "Optional literal shell arguments. Replaces VS Code default-profile or login arguments; [] supplies none. At most 128 arguments, 8192 UTF-8 bytes each and 32768 bytes total including separators. Quotes and spaces are preserved."
                  },
                  "env": {
                    "type": "object",
                    "maxProperties": 128,
                    "propertyNames": {
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[^=\u0000-\u001f]+$",
                      "not": {
                        "enum": [
                          "__proto__",
                          "constructor",
                          "prototype"
                        ]
                      }
                    },
                    "additionalProperties": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 8192,
                      "pattern": "^[^\u0000]*$"
                    },
                    "description": "Optional environment overrides applied after inherited and VS Code default-profile values, before shell lookup. Null removes a variable. Names are case-insensitive on Windows; reserved prototype names are rejected. At most 128 variables, 256 UTF-8 bytes per name, 8192 per value and 32768 in total including separators. Keep secrets out of synced settings."
                  }
                }
              },
              "description": "Primary Side Bar startup sections."
            },
            "right": {
              "type": "array",
              "default": [],
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "name"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,64}$",
                    "description": "Stable unique ID. The visual editor creates this automatically."
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80,
                    "description": "Name of the tab opened at sidebar startup."
                  },
                  "command": {
                    "type": "string",
                    "default": "",
                    "maxLength": 8192,
                    "description": "Command to run once when this terminal starts. Blank opens an interactive shell."
                  },
                  "shell": {
                    "type": "string",
                    "default": "",
                    "maxLength": 1024,
                    "description": "Optional shell executable: powershell, cmd, bash, zsh, fish, or an executable path. Blank uses the VS Code default shell, then the system default. Do not include arguments."
                  },
                  "args": {
                    "type": "array",
                    "maxItems": 128,
                    "items": {
                      "type": "string",
                      "maxLength": 8192,
                      "pattern": "^[^\u0000]*$"
                    },
                    "description": "Optional literal shell arguments. Replaces VS Code default-profile or login arguments; [] supplies none. At most 128 arguments, 8192 UTF-8 bytes each and 32768 bytes total including separators. Quotes and spaces are preserved."
                  },
                  "env": {
                    "type": "object",
                    "maxProperties": 128,
                    "propertyNames": {
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[^=\u0000-\u001f]+$",
                      "not": {
                        "enum": [
                          "__proto__",
                          "constructor",
                          "prototype"
                        ]
                      }
                    },
                    "additionalProperties": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 8192,
                      "pattern": "^[^\u0000]*$"
                    },
                    "description": "Optional environment overrides applied after inherited and VS Code default-profile values, before shell lookup. Null removes a variable. Names are case-insensitive on Windows; reserved prototype names are rejected. At most 128 variables, 256 UTF-8 bytes per name, 8192 per value and 32768 in total including separators. Keep secrets out of synced settings."
                  }
                }
              },
              "description": "Secondary Side Bar startup tabs."
            }
          }
        },
        "terminalSidebar.markdownFontFamily": {
          "type": "string",
          "scope": "application",
          "default": "default",
          "maxLength": 256,
          "markdownDescription": "Font family for Markdown previews. `default` follows VS Code; `editor` follows the editor font. A font name or comma-separated fallback list is also accepted. Saved in User settings and included in Settings Sync."
        }
      }
    },
    "keybindings": [
      {
        "command": "terminalSidebar.left.find",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "focusedView == terminalSidebar.left && !terminalSidebar.left.configuring"
      },
      {
        "command": "terminalSidebar.right.find",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "focusedView == terminalSidebar.terminals && !terminalSidebar.right.configuring"
      }
    ]
  },
  "scripts": {
    "generate:codicons": "node scripts/generate_codicons.mjs --write",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/prepare_pty.mjs",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "vscode:prepublish": "npm run check",
    "package": "node scripts/package.mjs --pre-release"
  },
  "dependencies": {
    "@mdit/plugin-footnote": "1.1.1",
    "@mdit/plugin-tasklist": "1.1.1",
    "@mdit/plugin-tex": "1.1.1",
    "@vscode/codicons": "0.0.46-24",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "css-tree": "3.2.1",
    "dompurify": "3.4.15",
    "jsonc-parser": "3.3.1",
    "katex": "0.18.7",
    "markdown-it": "15.0.2",
    "node-pty": "1.1.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "prettier": "3.9.8"
  },
  "devDependencies": {
    "@types/css-tree": "3.2.0",
    "@types/jsdom": "30.0.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.20.3",
    "@types/vscode": "1.106.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
